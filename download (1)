import React, { useState } from 'react';
import { BusinessSponsor } from '../types';
import { Sparkles, X, ExternalLink, Copy, Check, MapPin, Tag, Gift, Star, Building2, CheckCircle2 } from 'lucide-react';
import { TaTaLogo } from './TaTaLogo';

interface SponsorRecommendationModalProps {
  sponsor: BusinessSponsor;
  taskTitle: string;
  onClose: () => void;
  onClaimSponsorPerk: (sponsorId: string) => void;
}

export const SponsorRecommendationModal: React.FC<SponsorRecommendationModalProps> = ({
  sponsor,
  taskTitle,
  onClose,
  onClaimSponsorPerk
}) => {
  const [copied, setCopied] = useState(false);
  const [claimed, setClaimed] = useState(false);

  const handleCopyCode = (e?: React.MouseEvent) => {
    e?.stopPropagation();
    if (sponsor.promoCode) {
      navigator.clipboard.writeText(sponsor.promoCode);
      setCopied(true);
      setTimeout(() => setCopied(false), 2500);
    }
  };

  const handleClaim = (e: React.MouseEvent) => {
    e.stopPropagation();
    onClaimSponsorPerk(sponsor.id);
    setClaimed(true);
    handleCopyCode();
  };

  const handleOpenMap = (e: React.MouseEvent) => {
    e.stopPropagation();
    onClaimSponsorPerk(sponsor.id);
    if (sponsor.mapUrl) {
      window.open(sponsor.mapUrl, '_blank', 'noopener,noreferrer');
    }
  };

  return (
    <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 sm:p-6 bg-slate-950/80 backdrop-blur-md animate-fadeIn">
      {/* Modal Dialog Container */}
      <div 
        className="relative w-full max-w-lg bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 border border-cyan-500/40 rounded-3xl shadow-2xl shadow-cyan-500/20 overflow-hidden text-slate-100 ring-2 ring-cyan-500/20"
        onClick={(e) => e.stopPropagation()}
      >
        {/* Top Glow Bar */}
        <div className="h-2 w-full bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-500" />

        {/* Close Button */}
        <button
          id="btn-close-sponsor-popup"
          onClick={onClose}
          className="absolute top-4 right-4 p-2 rounded-full bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-white transition-colors z-10"
          title="Close suggestion"
        >
          <X className="w-5 h-5" />
        </button>

        <div className="p-6 sm:p-8">
          {/* Header Badge */}
          <div className="flex items-center gap-2 mb-3">
            <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-cyan-950 to-blue-950 border border-cyan-500/40 text-cyan-300 text-xs font-bold uppercase tracking-wider shadow-inner">
              <Sparkles className="w-3.5 h-3.5 text-cyan-400 animate-pulse" />
              Sponsor Store Offer Match
            </span>
            <TaTaLogo size={24} />
          </div>

          {/* Title & Task Context */}
          <h3 className="text-xl sm:text-2xl font-black text-white tracking-tight">
            Exclusive Perk Suggested!
          </h3>
          <p className="text-xs sm:text-sm text-slate-300 mt-1">
            For your voice task: <strong className="text-cyan-300 italic">"{taskTitle}"</strong>
          </p>

          {/* Main Sponsor Card (Clickable) */}
          <div 
            onClick={handleClaim}
            className="mt-5 p-5 rounded-2xl bg-gradient-to-br from-slate-800/90 to-slate-900/90 border border-cyan-500/30 hover:border-cyan-400/80 transition-all cursor-pointer group shadow-lg relative overflow-hidden"
          >
            {/* Background subtle sheen */}
            <div className="absolute -right-10 -bottom-10 w-32 h-32 rounded-full bg-cyan-500/10 blur-2xl group-hover:bg-cyan-500/20 transition-all" />

            <div className="flex items-start justify-between gap-3 relative z-10">
              <div className="flex items-center gap-3">
                <div className="w-14 h-14 rounded-2xl bg-slate-700/80 border border-slate-600 flex items-center justify-center text-3xl shadow-md group-hover:scale-105 transition-transform shrink-0">
                  {sponsor.logo || '🛍️'}
                </div>
                <div>
                  <div className="flex items-center gap-2">
                    <h4 className="font-bold text-white text-base group-hover:text-cyan-300 transition-colors">
                      {sponsor.businessName}
                    </h4>
                    {sponsor.rating && (
                      <span className="flex items-center gap-1 text-[11px] px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 font-semibold border border-amber-500/20">
                        <Star className="w-3 h-3 fill-amber-400 text-amber-400" />
                        {sponsor.rating}
                      </span>
                    )}
                  </div>
                  <p className="text-xs text-slate-400 flex items-center gap-1 mt-0.5">
                    <Building2 className="w-3 h-3 text-cyan-400" />
                    {sponsor.category}
                  </p>
                  <p className="text-xs text-slate-400 flex items-center gap-1 mt-0.5">
                    <MapPin className="w-3 h-3 text-slate-500" />
                    {sponsor.locationName}
                  </p>
                </div>
              </div>

              {/* Discount Badge */}
              {sponsor.discountPct && (
                <span className="px-3 py-1.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-extrabold text-xs sm:text-sm shadow-md shadow-cyan-500/30 shrink-0">
                  {sponsor.discountPct}
                </span>
              )}
            </div>

            {/* Offer Details */}
            <div className="mt-4 pt-3 border-t border-slate-700/60 relative z-10">
              <p className="text-sm font-semibold text-cyan-200">
                {sponsor.offerTitle}
              </p>
              <p className="text-xs text-slate-300 mt-1 leading-relaxed">
                {sponsor.offerDescription}
              </p>
            </div>

            {/* Promo Code Box */}
            {sponsor.promoCode && (
              <div className="mt-4 flex items-center justify-between p-3 rounded-xl bg-slate-950/80 border border-slate-800 text-xs relative z-10">
                <div className="flex items-center gap-2">
                  <Tag className="w-4 h-4 text-cyan-400 shrink-0" />
                  <span className="text-slate-400">Code:</span>
                  <code className="font-mono font-bold text-cyan-300 tracking-wider text-sm">
                    {sponsor.promoCode}
                  </code>
                </div>
                <button
                  type="button"
                  onClick={handleCopyCode}
                  className="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-cyan-300 font-semibold text-xs flex items-center gap-1 transition-colors"
                >
                  {copied ? (
                    <>
                      <Check className="w-3.5 h-3.5 text-emerald-400" />
                      <span className="text-emerald-400">Copied!</span>
                    </>
                  ) : (
                    <>
                      <Copy className="w-3.5 h-3.5" />
                      <span>Copy</span>
                    </>
                  )}
                </button>
              </div>
            )}
          </div>

          {/* Claim Status Notification */}
          {claimed && (
            <div className="mt-3 p-3 rounded-xl bg-emerald-950/80 border border-emerald-700/60 text-emerald-300 text-xs flex items-center gap-2 animate-fadeIn">
              <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
              <span>Perk claimed successfully! The code has been copied and saved to your reminder.</span>
            </div>
          )}

          {/* Action Buttons */}
          <div className="mt-6 flex flex-col sm:flex-row items-center gap-3">
            <button
              id="btn-claim-sponsor-modal"
              onClick={handleClaim}
              className="w-full sm:flex-1 py-3.5 px-5 rounded-2xl font-bold text-sm bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-white shadow-lg shadow-cyan-500/30 flex items-center justify-center gap-2 transition-all hover:scale-[1.02] active:scale-95"
            >
              <Gift className="w-4 h-4" />
              <span>{claimed ? 'Claimed! Copy Code Again' : 'Claim & Save Sponsor Perk'}</span>
            </button>

            {sponsor.mapUrl && (
              <button
                id="btn-view-map-sponsor-modal"
                onClick={handleOpenMap}
                className="w-full sm:w-auto py-3.5 px-4 rounded-2xl font-semibold text-xs bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-700 flex items-center justify-center gap-1.5 transition-colors shrink-0"
              >
                <ExternalLink className="w-4 h-4" />
                <span>Store Map</span>
              </button>
            )}
          </div>

          {/* Dismiss option */}
          <div className="mt-4 text-center">
            <button
              id="btn-dismiss-sponsor-modal"
              onClick={onClose}
              className="text-xs text-slate-500 hover:text-slate-300 underline underline-offset-2 transition-colors"
            >
              Dismiss & View Reminders
            </button>
          </div>
        </div>
      </div>
    </div>
  );
};

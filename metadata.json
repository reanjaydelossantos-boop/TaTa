                  className="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-extrabold py-2.5 rounded-xl text-xs shadow-lg shadow-purple-600/30 cursor-pointer"
                >
                  Upgrade to Pro (₱{pricingTiers.proMonthlyPrice}/mo)
                </button>
              </div>

              {/* Partner Tier */}

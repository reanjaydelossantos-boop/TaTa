import React, { useState } from 'react';
import { 
  BusinessSponsor, PaymentGatewayConfig, PricingTierConfig, 
  PartnershipApplication, BusinessInquiryForm, AppSystemMetrics, 
  AppFeatureToggles, UserPlan 
} from '../types';
import { 
  Globe, CreditCard, Building2, ShieldCheck, Sparkles, CheckCircle2, 
  ArrowRight, Key, DollarSign, Layers, Activity, Users, FileText, 
  Settings, Lock, Unlock, Zap, Crown, Send, RefreshCw, AlertCircle, 
  ChevronRight, Camera, Mic, Mail, Phone, MapPin, Check, X, Clock, 
  ExternalLink, BarChart3, Sliders, Play, Eye, Home
} from 'lucide-react';
import { TaTaLogo } from './TaTaLogo';

interface OfficialAppManagementPortalProps {
  sponsors: BusinessSponsor[];
  onAddSponsor: (sponsor: BusinessSponsor) => void;
  onUpdateSponsor: (sponsor: BusinessSponsor) => void;
  onToggleSponsorStatus: (id: string) => void;
  onLaunchApp: () => void;
  userPlan: UserPlan;
  setUserPlan: (plan: UserPlan) => void;
  paymentConfig: PaymentGatewayConfig;
  onUpdatePaymentConfig: (config: PaymentGatewayConfig) => void;
  pricingTiers: PricingTierConfig;
  onUpdatePricingTiers: (tiers: PricingTierConfig) => void;
  applications: PartnershipApplication[];
  onAddApplication: (app: PartnershipApplication) => void;
  onUpdateApplicationStatus: (id: string, status: PartnershipApplication['status'], notes?: string) => void;
  inquiries: BusinessInquiryForm[];
  onAddInquiry: (inquiry: BusinessInquiryForm) => void;
  onUpdateInquiryStatus: (id: string, status: BusinessInquiryForm['status']) => void;
  metrics: AppSystemMetrics;
  featureToggles: AppFeatureToggles;
  onToggleFeature: (featureKey: keyof AppFeatureToggles) => void;
}

export const OfficialAppManagementPortal: React.FC<OfficialAppManagementPortalProps> = ({
  sponsors,
  onAddSponsor,
  onUpdateSponsor,
  onToggleSponsorStatus,
  onLaunchApp,
  userPlan,
  setUserPlan,
  paymentConfig,
  onUpdatePaymentConfig,
  pricingTiers,
  onUpdatePricingTiers,
  applications,
  onAddApplication,
  onUpdateApplicationStatus,
  inquiries,
  onAddInquiry,
  onUpdateInquiryStatus,
  metrics,
  featureToggles,
  onToggleFeature
}) => {
  // Navigation Section in Portal
  const [subTab, setSubTab] = useState<'website' | 'payment_setup' | 'partnerships' | 'business_forms' | 'system_admin'>('website');
  const [isStandaloneWebsiteView, setIsStandaloneWebsiteView] = useState(true);
  const [copiedUrlToast, setCopiedUrlToast] = useState(false);

  // Partnership Application Public Form State
  const [appBusinessName, setAppBusinessName] = useState('');
  const [appContactName, setAppContactName] = useState('');
  const [appContactEmail, setAppContactEmail] = useState('');
  const [appContactPhone, setAppContactPhone] = useState('');
  const [appCategory, setAppCategory] = useState('Food & Beverage');
  const [appOfferTitle, setAppOfferTitle] = useState('');
  const [appOfferDescription, setAppOfferDescription] = useState('');
  const [appPromoCode, setAppPromoCode] = useState('');
  const [appTargetKeywords, setAppTargetKeywords] = useState('');
  const [appDiscountPct, setAppDiscountPct] = useState('20% OFF');
  const [appLocationName, setAppLocationName] = useState('');
  const [appMonthlyBudget, setAppMonthlyBudget] = useState('100');
  const [appSubmittedNotice, setAppSubmittedNotice] = useState(false);

  // Business / Enterprise Inquiry Public Form State
  const [inqFormType, setInqFormType] = useState<BusinessInquiryForm['formType']>('enterprise_license');
  const [inqSenderName, setInqSenderName] = useState('');
  const [inqSenderEmail, setInqSenderEmail] = useState('');
  const [inqCompanyName, setInqCompanyName] = useState('');
  const [inqSubject, setInqSubject] = useState('');
  const [inqMessage, setInqMessage] = useState('');
  const [inqSubmittedNotice, setInqSubmittedNotice] = useState(false);

  // Payment Setup Form State
  const [paymentMode, setPaymentMode] = useState(paymentConfig.mode);
  const [currency, setCurrency] = useState(paymentConfig.currency);
  const [stripeEnabled, setStripeEnabled] = useState(paymentConfig.stripeEnabled);
  const [stripePubKey, setStripePubKey] = useState(paymentConfig.stripePublishableKey);
  const [stripeSecKey, setStripeSecKey] = useState(paymentConfig.stripeSecretKey);
  const [paypalEnabled, setPaypalEnabled] = useState(paymentConfig.paypalEnabled);
  const [paypalClientId, setPaypalClientId] = useState(paymentConfig.paypalClientId);
  const [autoPayouts, setAutoPayouts] = useState(paymentConfig.autoPayouts);
  const [payoutInterval, setPayoutInterval] = useState(paymentConfig.payoutInterval);
  const [payoutAccount, setPayoutAccount] = useState(paymentConfig.payoutAccount);
  const [paymentSavedNotice, setPaymentSavedNotice] = useState(false);

  // Pricing Editor State
  const [proPrice, setProPrice] = useState(pricingTiers.proMonthlyPrice.toString());
  const [partnerPrice, setPartnerPrice] = useState(pricingTiers.partnerMonthlyPrice.toString());

  React.useEffect(() => {
    setProPrice(pricingTiers.proMonthlyPrice.toString());
    setPartnerPrice(pricingTiers.partnerMonthlyPrice.toString());
  }, [pricingTiers.proMonthlyPrice, pricingTiers.partnerMonthlyPrice]);

  // Handle Submit Public Partnership Application
  const handleSubmitPartnershipApp = (e: React.FormEvent) => {
    e.preventDefault();
    if (!appBusinessName || !appContactEmail || !appOfferTitle) {
      alert('Please fill out all required partnership details.');
      return;
    }

    const keywordsArray = appTargetKeywords
      .split(',')
      .map(k => k.trim().toLowerCase())
      .filter(Boolean);

    const newApp: PartnershipApplication = {
      id: `app-${Date.now().toString().slice(-5)}`,
      businessName: appBusinessName.trim(),
      contactName: appContactName.trim() || 'Business Representative',
      contactEmail: appContactEmail.trim(),
      contactPhone: appContactPhone.trim() || 'N/A',
      category: appCategory,
      offerTitle: appOfferTitle.trim(),
      offerDescription: appOfferDescription.trim() || 'Special discount for TaTa app users.',
      promoCode: appPromoCode.trim().toUpperCase() || `TATA${Math.floor(Math.random() * 899 + 100)}`,
      targetKeywords: keywordsArray.length > 0 ? keywordsArray : ['local', 'shopping', 'offer'],
      discountPct: appDiscountPct.trim() || '15% OFF',
      locationName: appLocationName.trim() || 'City Center Branch',
      proposedBudgetMonthly: parseFloat(appMonthlyBudget) || 100,
      status: 'pending',
      submittedAt: new Date().toISOString()
    };

    onAddApplication(newApp);

    // Reset Form
    setAppBusinessName('');
    setAppContactName('');
    setAppContactEmail('');
    setAppContactPhone('');
    setAppOfferTitle('');
    setAppOfferDescription('');
    setAppPromoCode('');
    setAppTargetKeywords('');
    setAppLocationName('');
    setAppSubmittedNotice(true);

    setTimeout(() => {
      setAppSubmittedNotice(false);
    }, 6000);
  };

  // Handle Submit Public Enterprise / Support Form
  const handleSubmitInquiry = (e: React.FormEvent) => {
    e.preventDefault();
    if (!inqSenderName || !inqSenderEmail || !inqMessage) {
      alert('Please fill out name, email, and message.');
      return;
    }

    const newInquiry: BusinessInquiryForm = {
      id: `inq-${Date.now().toString().slice(-5)}`,
      formType: inqFormType,
      senderName: inqSenderName.trim(),
      senderEmail: inqSenderEmail.trim(),
      companyName: inqCompanyName.trim() || 'N/A',
      subject: inqSubject.trim() || `Inquiry regarding ${inqFormType.replace('_', ' ')}`,
      message: inqMessage.trim(),
      status: 'new',
      submittedAt: new Date().toISOString()
    };

    onAddInquiry(newInquiry);

    setInqSenderName('');
    setInqSenderEmail('');
    setInqCompanyName('');
    setInqSubject('');
    setInqMessage('');
    setInqSubmittedNotice(true);

    setTimeout(() => {
      setInqSubmittedNotice(false);
    }, 6000);
  };

  // Save Payment Setup Config
  const handleSavePaymentConfig = (e: React.FormEvent) => {
    e.preventDefault();
    const updated: PaymentGatewayConfig = {
      ...paymentConfig,
      mode: paymentMode,
      currency: currency,
      stripeEnabled: stripeEnabled,
      stripePublishableKey: stripePubKey,
      stripeSecretKey: stripeSecKey,
      paypalEnabled: paypalEnabled,
      paypalClientId: paypalClientId,
      autoPayouts: autoPayouts,
      payoutInterval: payoutInterval,
      payoutAccount: payoutAccount
    };

    onUpdatePaymentConfig(updated);

    const updatedTiers: PricingTierConfig = {
      ...pricingTiers,
      proMonthlyPrice: parseFloat(proPrice) || 299,
      partnerMonthlyPrice: parseFloat(partnerPrice) || 2999
    };
    onUpdatePricingTiers(updatedTiers);

    setPaymentSavedNotice(true);
    setTimeout(() => setPaymentSavedNotice(false), 4000);
  };

  // Approve Partnership & Auto-Register Sponsor
  const handleApproveApplication = (app: PartnershipApplication) => {
    onUpdateApplicationStatus(app.id, 'approved', 'Approved by Admin. Auto-generated partner sponsor listing.');

    const newSponsor: BusinessSponsor = {
      id: `spon-app-${Date.now().toString().slice(-4)}`,
      partnerCode: `BP-${app.businessName.toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 8)}-${Math.floor(Math.random() * 899 + 100)}`,
      businessName: app.businessName,
      logo: app.category.includes('Food') ? '☕' : app.category.includes('Health') ? '🏋️' : app.category.includes('Auto') ? '🚗' : '🛍️',
      category: app.category,
      offerTitle: app.offerTitle,
      offerDescription: app.offerDescription,
      promoCode: app.promoCode,
      targetKeywords: app.targetKeywords,
      discountPct: app.discountPct,
      rating: 5.0,
      locationName: app.locationName,
      mapUrl: 'https://maps.google.com',
      impressions: 0,
      clicks: 0,
      redemptions: 0,
      costPerRedemption: '$0.50',
      active: true,
      contactEmail: app.contactEmail,
      partnerSince: new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
    };

    onAddSponsor(newSponsor);
  };

  if (isStandaloneWebsiteView) {
    return (
      <div className="min-h-screen bg-slate-950 text-slate-100 font-sans pb-16">
        {/* Sticky Official Website Navigation Header Bar */}
        <header className="sticky top-0 z-50 bg-slate-900/95 border-b border-cyan-500/30 px-4 sm:px-8 py-3 backdrop-blur-md shadow-2xl">
          <div className="max-w-7xl mx-auto flex items-center justify-between gap-4">
            
            {/* Website Brand Logo */}
            <div className="flex items-center gap-3 cursor-pointer" onClick={onLaunchApp}>
              <TaTaLogo size={36} />
              <div>
                <div className="flex items-center gap-2">
                  <span className="text-xl font-black text-white tracking-tight">TaTa</span>
                  <span className="text-[10px] bg-cyan-950 text-cyan-300 border border-cyan-800 px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">
                    Official Website
                  </span>
                </div>
                <p className="text-[11px] text-slate-400 hidden sm:block">TalkTask AI & Pro Photo/Audio Assistant</p>
              </div>
            </div>

            {/* Middle Nav Links */}
            <nav className="hidden lg:flex items-center gap-6 text-xs font-bold text-slate-300">
              <button 
                type="button" 
                onClick={onLaunchApp}
                className="text-cyan-400 hover:text-white transition-colors flex items-center gap-1.5 font-black uppercase tracking-wider bg-cyan-950/80 px-2.5 py-1 rounded-lg border border-cyan-800 cursor-pointer shadow-sm"
              >
                <Home className="w-3.5 h-3.5 text-cyan-400" />
                <span>HOME (App)</span>
              </button>
              <a href="#features-showcase-section" className="hover:text-cyan-400 transition-colors">Features</a>
              <a href="#official-pricing-section" className="hover:text-cyan-400 transition-colors">Membership Pricing</a>
              <a href="#partner-application-section-standalone" className="hover:text-amber-400 transition-colors flex items-center gap-1">
                <Building2 className="w-3.5 h-3.5 text-amber-400" />
                <span>Partner Perks</span>
              </a>
              <button
                type="button"
                onClick={() => setIsStandaloneWebsiteView(false)}
                className="text-slate-400 hover:text-purple-300 font-semibold flex items-center gap-1.5 transition-colors cursor-pointer"
              >
                <Settings className="w-3.5 h-3.5 text-purple-400" />
                <span>Admin Console</span>
              </button>
            </nav>

            {/* Right Action Button */}
            <div className="flex items-center gap-3">
              <button
                type="button"
                onClick={() => setIsStandaloneWebsiteView(false)}
                className="lg:hidden px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold flex items-center gap-1 cursor-pointer"
              >
                <Settings className="w-3.5 h-3.5 text-purple-400" />
                <span>Admin</span>
              </button>
              <button
                type="button"
                onClick={onLaunchApp}
                className="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-extrabold text-xs sm:text-sm flex items-center gap-2 shadow-lg shadow-cyan-500/20 active:scale-95 transition-all cursor-pointer"
              >
                <Home className="w-4 h-4" />
                <span>HOME (Launch App)</span>
              </button>
            </div>
          </div>
        </header>

        {/* Pure Standalone Website Landing Page */}
        <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-16 animate-fadeIn">
          {/* Hero Section */}
          <section className="relative rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900 to-cyan-950 border border-slate-800 p-8 sm:p-12 overflow-hidden shadow-2xl">
            <div className="absolute top-0 right-0 -mr-16 -mt-16 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div className="absolute bottom-0 left-0 -ml-16 -mb-16 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div className="relative z-10 max-w-3xl space-y-6">
              <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/80 border border-cyan-800 text-cyan-300 text-xs font-bold uppercase tracking-wider">
                <TaTaLogo size={20} />
                <span>Official Product Website</span>
              </div>

              <h1 className="text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight">
                TaTa — TalkTask AI Assistant & Pro Photo/Audio Intelligence
              </h1>

              <p className="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
                The ultimate voice-first task manager, whiteboard/document photo-to-text OCR converter, AI strategy decision engine, and local merchant partnership ecosystem.
              </p>

              <div className="flex flex-wrap items-center gap-4 pt-2">
                <button
                  type="button"
                  onClick={onLaunchApp}
                  className="px-6 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-extrabold text-sm flex items-center gap-2 shadow-xl shadow-cyan-500/25 transition-all transform hover:-translate-y-0.5 cursor-pointer"
                >
                  <Play className="w-4 h-4 fill-white" />
                  <span>Launch TaTa Web App</span>
                </button>

                <a
                  href="#partner-application-section-standalone"
                  className="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 font-extrabold text-sm flex items-center gap-2 transition-all cursor-pointer"
                >
                  <Building2 className="w-4 h-4 text-amber-400" />
                  <span>Become a Merchant Partner</span>
                </a>
              </div>

              {/* Key Metrics Strip */}
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-slate-800/80">
                <div>
                  <span className="text-2xl font-black text-cyan-400">{metrics.activeUsersToday.toLocaleString()}</span>
                  <p className="text-xs text-slate-400 font-medium">Daily Active Users</p>
                </div>
                <div>
                  <span className="text-2xl font-black text-purple-400">{metrics.totalVoiceRequests.toLocaleString()}</span>
                  <p className="text-xs text-slate-400 font-medium">Voice Reminders</p>
                </div>
                <div>
                  <span className="text-2xl font-black text-amber-400">{metrics.totalPhotoOcrScans.toLocaleString()}</span>
                  <p className="text-xs text-slate-400 font-medium">Photo OCR Scans</p>
                </div>
                <div>
                  <span className="text-2xl font-black text-emerald-400">${metrics.grossVolumeAllTime.toLocaleString()}</span>
                  <p className="text-xs text-slate-400 font-medium">Platform Volume</p>
                </div>
              </div>
            </div>
          </section>

          {/* Core Features Showcase Grid */}
          <section className="space-y-6">
            <div className="text-center max-w-2xl mx-auto space-y-2">
              <h2 className="text-2xl sm:text-3xl font-black text-white">Engineered for Executive Productivity</h2>
              <p className="text-sm text-slate-400">Discover four core pillars powering the TaTa intelligence ecosystem.</p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              <div className="bg-slate-900/80 rounded-2xl border border-slate-800 p-6 space-y-3 hover:border-cyan-500/50 transition-colors">
                <div className="p-3 rounded-xl bg-cyan-950 text-cyan-400 border border-cyan-800/80 w-fit">
                  <Mic className="w-6 h-6" />
                </div>
                <h3 className="text-lg font-bold text-white">Voice Speech Assistant</h3>
                <p className="text-xs text-slate-400 leading-relaxed">
                  Set daily reminders, schedule events, or query weather by speaking naturally into the microphone orb.
                </p>
              </div>

              <div className="bg-slate-900/80 rounded-2xl border border-slate-800 p-6 space-y-3 hover:border-amber-500/50 transition-colors">
                <div className="p-3 rounded-xl bg-amber-950 text-amber-400 border border-amber-800/80 w-fit">
                  <Camera className="w-6 h-6" />
                </div>
                <h3 className="text-lg font-bold text-white">Photo & Whiteboard OCR</h3>
                <p className="text-xs text-slate-400 leading-relaxed">
                  Snap photos of whiteboards, meeting notes, or printed memos to extract structured text & action items instantly.
                </p>
              </div>

              <div className="bg-slate-900/80 rounded-2xl border border-slate-800 p-6 space-y-3 hover:border-purple-500/50 transition-colors">
                <div className="p-3 rounded-xl bg-purple-950 text-purple-400 border border-purple-800/80 w-fit">
                  <Sparkles className="w-6 h-6" />
                </div>
                <h3 className="text-lg font-bold text-white">AI Strategy Matrix</h3>
                <p className="text-xs text-slate-400 leading-relaxed">
                  Evaluates trade-offs, pros & cons, risk ratings, and recommended owner actions for audio and photo memos.
                </p>
              </div>

              <div className="bg-slate-900/80 rounded-2xl border border-slate-800 p-6 space-y-3 hover:border-emerald-500/50 transition-colors">
                <div className="p-3 rounded-xl bg-emerald-950 text-emerald-400 border border-emerald-800/80 w-fit">
                  <Building2 className="w-6 h-6" />
                </div>
                <h3 className="text-lg font-bold text-white">Merchant Perks Network</h3>
                <p className="text-xs text-slate-400 leading-relaxed">
                  Task-keyword matching connects users with exclusive discounts (coffee, automotive, dining, fitness) at checkout.
                </p>
              </div>
            </div>
          </section>

          {/* Pricing Section */}
          <section className="space-y-6">
            <div className="text-center max-w-2xl mx-auto space-y-2">
              <h2 className="text-2xl sm:text-3xl font-black text-white">Official Membership Pricing</h2>
              <p className="text-sm text-slate-400">Choose a plan designed for individual productivity or local business growth.</p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              {/* Free Plan */}
              <div className="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-6 flex flex-col justify-between">
                <div className="space-y-4">
                  <div className="flex items-center justify-between">
                    <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Consumer</span>
                    <span className="px-2 py-0.5 rounded bg-slate-800 text-slate-300 text-[10px] font-bold">Standard</span>
                  </div>
                  <div>
                    <h3 className="text-2xl font-black text-white">Free Starter</h3>
                    <div className="flex items-baseline gap-1 mt-1">
                      <span className="text-4xl font-extrabold text-white">₱0</span>
                      <span className="text-xs text-slate-400">/ forever</span>
                    </div>
                  </div>
                  <ul className="space-y-2 text-xs text-slate-300 pt-2 border-t border-slate-800">
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-cyan-400" /> Live Voice Assistant Microphone</li>
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-cyan-400" /> Unlimited Task Reminders</li>
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-cyan-400" /> Daily Briefing & Weather Intelligence</li>
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-cyan-400" /> Local Merchant Sponsor Perks & Vouchers</li>
                  </ul>
                </div>
                <button
                  type="button"
                  onClick={onLaunchApp}
                  className="w-full bg-slate-800 hover:bg-slate-700 text-white font-bold py-2.5 rounded-xl text-xs cursor-pointer"
                >
                  Use Free App
                </button>
              </div>

              {/* Pro Tier */}
              <div className="bg-gradient-to-b from-purple-950/80 to-slate-900 rounded-2xl border-2 border-purple-500/60 p-6 space-y-6 flex flex-col justify-between relative shadow-2xl">
                <div className="absolute -top-3 left-1/2 -translate-x-1/2 bg-purple-600 text-white text-[10px] font-black uppercase tracking-wider px-3 py-0.5 rounded-full shadow-lg">
                  MOST POPULAR FOR PROFESSIONALS
                </div>
                <div className="space-y-4 pt-2">
                  <div className="flex items-center justify-between">
                    <span className="text-xs font-bold text-purple-300 uppercase tracking-wider">Executive</span>
                    <Crown className="w-4 h-4 text-amber-400" />
                  </div>
                  <div>
                    <h3 className="text-2xl font-black text-white">Pro Audio & Photo OCR</h3>
                    <div className="flex items-baseline gap-1 mt-1">
                      <span className="text-4xl font-extrabold text-purple-300">₱{pricingTiers.proMonthlyPrice}</span>
                      <span className="text-xs text-slate-400">/ month</span>
                    </div>
                  </div>
                  <ul className="space-y-2 text-xs text-slate-200 pt-2 border-t border-purple-900/60">
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-amber-400" /> Everything in Free Starter</li>
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-amber-400" /> 📷 Photo & Whiteboard OCR Scanner</li>
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-amber-400" /> 🎙️ Meeting & Audio Memo Summarizer</li>
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-amber-400" /> ⚡ Interactive AI Decision Matrix Engine</li>
                    <li className="flex items-center gap-2"><Check className="w-4 h-4 text-amber-400" /> PDF/Markdown Decision Export</li>

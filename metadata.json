                    className="px-3.5 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-xl cursor-pointer transition-all active:scale-95 flex items-center gap-1.5 shadow-md shadow-amber-500/20"
                  >
                    <CheckCircle2 className="w-3.5 h-3.5" />
                    <span>Save Pricing Only</span>
                  </button>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="text-xs text-slate-300 font-semibold block mb-1">Pro Audio & Photo OCR (₱/mo)</label>
                    <input
                      type="number"
                      value={proPrice}
                      onChange={(e) => setProPrice(e.target.value)}
                      className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs text-white font-bold focus:border-amber-500 focus:outline-none"
                    />
                  </div>

                  <div>
                    <label className="text-xs text-slate-300 font-semibold block mb-1">Partner Sponsor Membership (₱/mo)</label>
                    <input
                      type="number"
                      value={partnerPrice}
                      onChange={(e) => setPartnerPrice(e.target.value)}
                      className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs text-white font-bold focus:border-amber-500 focus:outline-none"
                    />
                  </div>
                </div>
              </div>

              {/* Payout & Revenue Ledger Box */}
              <div className="bg-slate-900 rounded-2xl border border-slate-800 p-6 space-y-4">
                <h3 className="text-sm font-bold text-white flex items-center gap-2">
                  <DollarSign className="w-4 h-4 text-emerald-400" />
                  Automated Merchant Payout Account
                </h3>

                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div>
                    <label className="text-xs text-slate-300 font-semibold block mb-1">Payout Account</label>
                    <input
                      type="text"
                      value={payoutAccount}
                      onChange={(e) => setPayoutAccount(e.target.value)}
                      className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs text-white"
                    />
                  </div>

                  <div>
                    <label className="text-xs text-slate-300 font-semibold block mb-1">Payout Frequency</label>
                    <select
                      value={payoutInterval}
                      onChange={(e) => setPayoutInterval(e.target.value as any)}
                      className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs text-white"
                    >
                      <option value="daily">Daily Automated Payout</option>
                      <option value="weekly">Weekly Payout (Fridays)</option>
                      <option value="monthly">Monthly Payout (1st of month)</option>
                    </select>
                  </div>

                  <div className="flex flex-col justify-end">
                    <button
                      type="button"
                      onClick={() => alert(`Initiated instant bank payout for ${payoutAccount}. Funds will settle in 1 business day.`)}
                      className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-2"
                    >
                      <RefreshCw className="w-3.5 h-3.5" />
                      <span>Trigger Instant Payout</span>
                    </button>
                  </div>
                </div>
              </div>

              {paymentSavedNotice && (
                <div className="p-4 bg-emerald-950 border border-emerald-800 rounded-xl text-emerald-300 text-xs font-bold flex items-center gap-2 animate-fadeIn">
                  <CheckCircle2 className="w-5 h-5 text-emerald-400 shrink-0" />
                  <span>Payment setup and pricing tier configurations saved successfully! Updated pricing is immediately live on the Subscription Pricing Modal.</span>
                </div>
              )}

              <button
                type="submit"
                className="w-full bg-purple-600 hover:bg-purple-500 text-white font-extrabold py-3.5 rounded-xl text-xs sm:text-sm shadow-xl shadow-purple-600/30 flex items-center justify-center gap-2 cursor-pointer transition-all active:scale-[0.99]"
              >
                <CheckCircle2 className="w-4 h-4" />
                <span>Save Payment & Pricing Setup</span>
              </button>
            </form>
          </div>
        )}

        {/* ============================================================== */}
        {/* SUBTAB 3: PARTNERSHIP MANAGEMENT SUITE */}
        {/* ============================================================== */}
        {subTab === 'partnerships' && (
          <div className="space-y-8 animate-fadeIn">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
              <div>
                <div className="flex items-center gap-2 mb-1">
                  <span className="text-xs font-bold text-amber-400 uppercase tracking-wider">Merchant Ecosystem</span>
                  <span className="text-[10px] bg-amber-950 text-amber-300 border border-amber-800 px-2 py-0.5 rounded-full font-bold">
                    {sponsors.length} Active Local Partners
                  </span>
                </div>
                <h2 className="text-2xl font-black text-white">Partnership Management Suite</h2>
                <p className="text-xs text-slate-400">Manage local business sponsors, review incoming merchant applications, and track redemption revenue.</p>
              </div>
            </div>

            {/* Incoming Partnership Applications Queue */}
            <div className="bg-slate-900 rounded-2xl border border-amber-500/40 p-6 space-y-4 shadow-xl">
              <div className="flex items-center justify-between">
                <h3 className="text-lg font-bold text-white flex items-center gap-2">
                  <Mail className="w-5 h-5 text-amber-400" />
                  <span>Incoming Business Applications Queue</span>
                  <span className="text-xs bg-amber-950 text-amber-300 px-2 py-0.5 rounded-full font-extrabold">
                    {applications.filter(a => a.status === 'pending').length} Pending
                  </span>
                </h3>
              </div>

              {applications.length === 0 ? (
                <p className="text-xs text-slate-400 italic py-4">No partnership applications received yet.</p>
              ) : (
                <div className="space-y-3">
                  {applications.map((app) => (
                    <div key={app.id} className="p-4 bg-slate-950 rounded-xl border border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4">
                      <div className="space-y-1 max-w-xl">
                        <div className="flex items-center gap-2">
                          <span className="text-sm font-extrabold text-white">{app.businessName}</span>
                          <span className="text-[10px] px-2 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800/80 font-bold">
                            {app.category}
                          </span>
                          <span className={`text-[10px] px-2 py-0.5 rounded font-bold uppercase ${
                            app.status === 'approved' ? 'bg-emerald-950 text-emerald-300 border border-emerald-800' :
                            app.status === 'rejected' ? 'bg-rose-950 text-rose-300 border border-rose-800' :
                            'bg-amber-950 text-amber-300 border border-amber-800'
                          }`}>
                            {app.status}
                          </span>
                        </div>
                        <p className="text-xs font-semibold text-slate-300">{app.offerTitle} ({app.discountPct})</p>
                        <p className="text-[11px] text-slate-400">{app.offerDescription}</p>
                        <div className="flex flex-wrap items-center gap-3 text-[10px] text-slate-500 pt-1">
                          <span>Contact: {app.contactName} ({app.contactEmail})</span>
                          <span>Budget: ${app.proposedBudgetMonthly}/mo</span>
                          <span>Code: {app.promoCode}</span>
                          <span>Keywords: {app.targetKeywords.join(', ')}</span>
                        </div>
                      </div>

                      <div className="flex items-center gap-2 shrink-0">
                        {app.status === 'pending' && (
                          <>
                            <button
                              onClick={() => handleApproveApplication(app)}
                              className="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center gap-1 shadow-md"
                            >
                              <Check className="w-3.5 h-3.5" />
                              <span>Approve & Issue Code</span>
                            </button>
                            <button
                              onClick={() => onUpdateApplicationStatus(app.id, 'rejected')}
                              className="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-rose-950 text-slate-300 hover:text-rose-300 font-bold text-xs flex items-center gap-1 border border-slate-700"
                            >
                              <X className="w-3.5 h-3.5" />
                              <span>Decline</span>
                            </button>
                          </>
                        )}
                        {app.status === 'approved' && (
                          <span className="text-xs text-emerald-400 font-bold flex items-center gap-1">
                            <CheckCircle2 className="w-4 h-4" /> Live in Sponsor Network
                          </span>
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* Live Partner Merchants Network */}
            <div className="space-y-4">
              <h3 className="text-lg font-bold text-white flex items-center gap-2">
                <Building2 className="w-5 h-5 text-amber-400" />
                <span>Active Partner Merchant Directory</span>
              </h3>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {sponsors.map((spon) => (
                  <div key={spon.id} className="bg-slate-900 p-5 rounded-2xl border border-slate-800 flex flex-col justify-between space-y-4">
                    <div className="flex items-start justify-between gap-3">
                      <div className="flex items-center gap-3">
                        <span className="text-3xl p-2 rounded-xl bg-slate-950 border border-slate-800">{spon.logo}</span>
                        <div>
                          <h4 className="text-base font-extrabold text-white">{spon.businessName}</h4>
                          <span className="text-[10px] text-amber-300 font-mono font-bold bg-amber-950/80 px-2 py-0.5 rounded border border-amber-800/80">
                            Code: {spon.partnerCode}
                          </span>
                        </div>
                      </div>

                      <button
                        onClick={() => onToggleSponsorStatus(spon.id)}
                        className={`px-2.5 py-1 rounded-full text-[10px] font-bold uppercase transition-all ${
                          spon.active
                            ? 'bg-emerald-950 text-emerald-300 border border-emerald-800'
                            : 'bg-slate-800 text-slate-400 border border-slate-700'
                        }`}
                      >
                        {spon.active ? 'Active' : 'Paused'}
                      </button>
                    </div>

                    <div className="space-y-1 text-xs">
                      <p className="font-bold text-slate-200">{spon.offerTitle}</p>
                      <p className="text-slate-400 text-[11px]">{spon.offerDescription}</p>
                    </div>

                    <div className="grid grid-cols-3 gap-2 pt-2 border-t border-slate-800 text-center">
                      <div className="p-2 bg-slate-950 rounded-lg">
                        <span className="text-sm font-extrabold text-white">{spon.impressions.toLocaleString()}</span>
                        <p className="text-[9px] text-slate-400">Impressions</p>
                      </div>
                      <div className="p-2 bg-slate-950 rounded-lg">
                        <span className="text-sm font-extrabold text-cyan-400">{spon.clicks.toLocaleString()}</span>
                        <p className="text-[9px] text-slate-400">Clicks</p>
                      </div>
                      <div className="p-2 bg-slate-950 rounded-lg">
                        <span className="text-sm font-extrabold text-emerald-400">{spon.redemptions.toLocaleString()}</span>
                        <p className="text-[9px] text-slate-400">Redemptions</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        )}

        {/* ============================================================== */}
        {/* SUBTAB 4: BUSINESS FORMS REPOSITORY */}
        {/* ============================================================== */}
        {subTab === 'business_forms' && (
          <div className="space-y-8 animate-fadeIn">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
              <div>
                <div className="flex items-center gap-2 mb-1">
                  <span className="text-xs font-bold text-emerald-400 uppercase tracking-wider">Operations & CRM</span>
                  <span className="text-[10px] bg-emerald-950 text-emerald-300 border border-emerald-800 px-2 py-0.5 rounded-full font-bold">
                    {inquiries.length} Submitted Forms
                  </span>
                </div>
                <h2 className="text-2xl font-black text-white">Business Forms & Inquiry Inbox</h2>
                <p className="text-xs text-slate-400">Centralized repository for enterprise requests, support tickets, and API webhook integrations.</p>
              </div>
            </div>

            <div className="space-y-4">
              {inquiries.length === 0 ? (
                <div className="p-8 bg-slate-900 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs italic">
                  No business inquiry forms submitted yet.
                </div>
              ) : (
                <div className="space-y-3">
                  {inquiries.map((inq) => (
                    <div key={inq.id} className="p-5 bg-slate-900 rounded-2xl border border-slate-800 space-y-3">
                      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
                        <div className="flex items-center gap-2">
                          <span className="text-sm font-extrabold text-white">{inq.subject}</span>
                          <span className="text-[10px] px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800 font-bold uppercase">
                            {inq.formType.replace('_', ' ')}
                          </span>
                        </div>
                        <div className="flex items-center gap-2">
                          <span className="text-[10px] text-slate-400">{new Date(inq.submittedAt).toLocaleString()}</span>
                          <select
                            value={inq.status}
                            onChange={(e) => onUpdateInquiryStatus(inq.id, e.target.value as any)}
                            className="bg-slate-950 border border-slate-800 rounded-lg text-xs font-bold px-2 py-1 text-slate-200"
                          >
                            <option value="new">NEW</option>
                            <option value="contacted">CONTACTED</option>
                            <option value="resolved">RESOLVED</option>
                          </select>
                        </div>
                      </div>

                      <p className="text-xs text-slate-300 leading-relaxed">{inq.message}</p>

                      <div className="flex items-center gap-4 text-[11px] text-slate-400 pt-1">
                        <span>Sender: <strong className="text-white">{inq.senderName}</strong> ({inq.senderEmail})</span>
                        <span>Company: <strong className="text-white">{inq.companyName}</strong></span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        {/* ============================================================== */}
        {/* SUBTAB 5: SYSTEM TELEMETRY & FEATURE TOGGLES */}
        {/* ============================================================== */}
        {subTab === 'system_admin' && (
          <div className="space-y-8 animate-fadeIn">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-800">
              <div>
                <div className="flex items-center gap-2 mb-1">
                  <span className="text-xs font-bold text-blue-400 uppercase tracking-wider">System Administration</span>
                  <span className="text-[10px] bg-blue-950 text-blue-300 border border-blue-800 px-2 py-0.5 rounded-full font-bold">
                    TaTa Engine Health: 100% Operational
                  </span>
                </div>
                <h2 className="text-2xl font-black text-white">System Telemetry & Feature Control</h2>
                <p className="text-xs text-slate-400">Monitor overall application usage, feature switches, and AI server connectivity.</p>
              </div>
            </div>

            {/* Feature Toggles Grid */}
            <div className="bg-slate-900 p-6 rounded-2xl border border-slate-800 space-y-4">
              <h3 className="text-sm font-bold text-white flex items-center gap-2">
                <Sliders className="w-4 h-4 text-blue-400" />
                Global Application Feature Switches
              </h3>

              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                
                <div className="p-4 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-between">
                  <div>
                    <span className="text-xs font-bold text-white block">Photo OCR Scanner</span>
                    <span className="text-[10px] text-slate-400">Image-to-text extraction</span>
                  </div>
                  <button
                    onClick={() => onToggleFeature('photoOcrEnabled')}
                    className={`w-11 h-6 rounded-full transition-colors relative p-1 ${
                      featureToggles.photoOcrEnabled ? 'bg-amber-500' : 'bg-slate-800'
                    }`}
                  >
                    <div className={`w-4 h-4 rounded-full bg-white transition-transform ${
                      featureToggles.photoOcrEnabled ? 'translate-x-5' : 'translate-x-0'
                    }`} />
                  </button>
                </div>

                <div className="p-4 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-between">
                  <div>
                    <span className="text-xs font-bold text-white block">Voice Synthesis Engine</span>
                    <span className="text-[10px] text-slate-400">Text-to-Speech audio briefs</span>
                  </div>
                  <button
                    onClick={() => onToggleFeature('voiceSynthEnabled')}
                    className={`w-11 h-6 rounded-full transition-colors relative p-1 ${
                      featureToggles.voiceSynthEnabled ? 'bg-cyan-500' : 'bg-slate-800'
                    }`}
                  >
                    <div className={`w-4 h-4 rounded-full bg-white transition-transform ${
                      featureToggles.voiceSynthEnabled ? 'translate-x-5' : 'translate-x-0'
                    }`} />
                  </button>
                </div>

                <div className="p-4 bg-slate-950 rounded-xl border border-slate-800 flex items-center justify-between">
                  <div>
                    <span className="text-xs font-bold text-white block">Sponsor Merchant Network</span>
                    <span className="text-[10px] text-slate-400">Task keyword offer matching</span>
                  </div>
                  <button
                    onClick={() => onToggleFeature('sponsorAdsEnabled')}
                    className={`w-11 h-6 rounded-full transition-colors relative p-1 ${
                      featureToggles.sponsorAdsEnabled ? 'bg-purple-500' : 'bg-slate-800'
                    }`}
                  >
                    <div className={`w-4 h-4 rounded-full bg-white transition-transform ${
                      featureToggles.sponsorAdsEnabled ? 'translate-x-5' : 'translate-x-0'
                    }`} />
                  </button>
                </div>

              </div>
            </div>

            {/* Operational Telemetry Cards */}
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-slate-400">Active Users (Overall Total)</span>
                  <Users className="w-4 h-4 text-cyan-400" />
                </div>
                <p className="text-3xl font-black text-cyan-400">{(metrics.overallTotalUsers || 24850).toLocaleString()}</p>
                <p className="text-[10px] text-slate-500">Registered accounts across Web & Mobile</p>
              </div>

              <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-slate-400 font-semibold">Users with Free Version</span>
                  <Users className="w-4 h-4 text-slate-400" />
                </div>
                <p className="text-3xl font-black text-slate-200">{(metrics.freeVersionUsers || 18620).toLocaleString()}</p>
                <p className="text-[10px] text-slate-500">Starter Tier active accounts (74.9%)</p>
              </div>

              <div className="bg-slate-900 p-5 rounded-2xl border border-purple-900/60 bg-gradient-to-b from-slate-900 to-purple-950/20 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-purple-300">Users with Pro Version</span>
                  <Crown className="w-4 h-4 text-purple-400" />
                </div>
                <p className="text-3xl font-black text-purple-400">{(metrics.proVersionUsers || 6230).toLocaleString()}</p>
                <p className="text-[10px] text-purple-300/70">TaTa Pro active members (25.1%)</p>
              </div>

              <div className="bg-slate-900 p-5 rounded-2xl border border-amber-900/60 bg-gradient-to-b from-slate-900 to-amber-950/20 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-amber-300">Business Partners</span>
                  <Building2 className="w-4 h-4 text-amber-400" />
                </div>
                <p className="text-3xl font-black text-amber-400">{(sponsors ? sponsors.length : (metrics.activePartnerships || 12)).toLocaleString()}</p>
                <p className="text-[10px] text-amber-300/70">Active merchant sponsors on network</p>
              </div>

              <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-slate-400">Monthly Recurring Revenue (MRR)</span>
                  <DollarSign className="w-4 h-4 text-emerald-400" />
                </div>
                <p className="text-3xl font-black text-emerald-400">₱{metrics.monthlyRecurringRevenue.toLocaleString()}</p>
                <p className="text-[10px] text-slate-500">+18.4% growth from previous cycle</p>
              </div>

              <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-slate-400">Total Voice Requests Processed</span>
                  <Mic className="w-4 h-4 text-blue-400" />
                </div>
                <p className="text-3xl font-black text-blue-400">{metrics.totalVoiceRequests.toLocaleString()}</p>
                <p className="text-[10px] text-slate-500">Gemini Flash low-latency pipeline</p>
              </div>

              <div className="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-2 sm:col-span-2 lg:col-span-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-slate-400">Total Coupon Redemptions</span>
                  <Sparkles className="w-4 h-4 text-amber-400" />
                </div>
                <p className="text-3xl font-black text-amber-400">{metrics.totalCouponsRedeemed.toLocaleString()}</p>
                <p className="text-[10px] text-slate-500 font-medium">Generated for local merchant network</p>
              </div>
            </div>

          </div>
        )}

      </main>

    </div>
  );
};

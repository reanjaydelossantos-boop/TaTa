import React from 'react';

interface TaTaLogoProps {
  className?: string;
  size?: number;
}

export const TaTaLogo: React.FC<TaTaLogoProps> = ({ className = '', size = 44 }) => {
  return (
    <div className={`relative inline-flex items-center justify-center shrink-0 ${className}`} style={{ width: size, height: size }}>
      <svg
        viewBox="0 0 100 100"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        className="w-full h-full drop-shadow-md"
      >
        <defs>
          {/* Background & Ring Gradients */}
          <linearGradient id="tata-bg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stopColor="#f0f9ff" />
            <stop offset="100%" stopColor="#e0f2fe" />
          </linearGradient>

          <linearGradient id="tata-ring-outer" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stopColor="#38bdf8" />
            <stop offset="100%" stopColor="#0284c7" />
          </linearGradient>

          <linearGradient id="tata-mic-grad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stopColor="#22d3ee" />
            <stop offset="50%" stopColor="#0284c7" />
            <stop offset="100%" stopColor="#0369a1" />
          </linearGradient>

          <linearGradient id="tata-sparkle-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stopColor="#c084fc" />
            <stop offset="100%" stopColor="#7e22ce" />
          </linearGradient>
        </defs>

        {/* Base Light Circular Container */}
        <circle cx="50" cy="50" r="46" fill="url(#tata-bg)" stroke="#bae6fd" strokeWidth="1.5" />

        {/* Outer Concentric Ring */}
        <circle cx="50" cy="50" r="43" fill="none" stroke="url(#tata-ring-outer)" strokeWidth="3" opacity="0.85" />
        {/* Inner Concentric Ring */}
        <circle cx="50" cy="50" r="38" fill="none" stroke="#7dd3fc" strokeWidth="1.5" opacity="0.7" />

        {/* Central Cyan Microphone */}
        <g transform="translate(0, -1)">
          {/* Mic Capsule */}
          <rect x="42" y="26" width="16" height="28" rx="8" fill="url(#tata-mic-grad)" />
          {/* Mic Stand U-bracket */}
          <path
            d="M34 40C34 49 41 56 50 56C59 56 66 49 66 40"
            stroke="url(#tata-mic-grad)"
            strokeWidth="4"
            strokeLinecap="round"
            fill="none"
          />
          {/* Mic Stand Base */}
          <path d="M50 56V65" stroke="url(#tata-mic-grad)" strokeWidth="4" strokeLinecap="round" />
          <path d="M41 65H59" stroke="url(#tata-mic-grad)" strokeWidth="4" strokeLinecap="round" />
        </g>

        {/* Top-Right Purple Sparkles */}
        <g transform="translate(62, 18) scale(0.75)" fill="url(#tata-sparkle-grad)">
          {/* Main 4-point star */}
          <path d="M12 0C12 6.627 6.627 12 0 12C6.627 12 12 17.373 12 24C12 17.373 17.373 12 24 12C17.373 12 12 6.627 12 0Z" />
          {/* Smaller secondary star */}
          <path d="M22 2C22 4.2 20.2 6 18 6C20.2 6 22 7.8 22 10C22 7.8 23.8 6 26 6C23.8 6 22 4.2 22 2Z" opacity="0.85" />
          {/* Tiny third star */}
          <path d="M6 20C6 21.3 4.7 22.5 3 22.5C4.7 22.5 6 23.7 6 25C6 23.7 7.3 22.5 9 22.5C7.3 22.5 6 21.3 6 20Z" opacity="0.75" />
        </g>

        {/* Bottom-Right Clock & Checkmark Badge */}
        <g transform="translate(60, 60)">
          {/* Outer Badge Background Circle */}
          <circle cx="16" cy="16" r="15" fill="#0f172a" stroke="#ffffff" strokeWidth="2" />
          {/* Clock Face Track */}
          <circle cx="16" cy="16" r="11" fill="none" stroke="#38bdf8" strokeWidth="2" strokeDasharray="18 8" />
          {/* Checkmark Icon inside clock */}
          <path
            d="M10 16L14 20L22 12"
            stroke="#38bdf8"
            strokeWidth="3"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
        </g>
      </svg>
    </div>
  );
